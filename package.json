{
  "name": "yxx-campus",
  "version": "0.1.0",
  "private": true,
  "description": "庆师易校圈 · 本地服务端（Express + JWT）",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "server/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/app.js",
    "server": "node server/app.js --open",
    "lint": "eslint --rulesdir ./eslint-rules .",
    "lint:fix": "eslint --rulesdir ./eslint-rules . --fix",
    "check:no-absolute": "node scripts/check-no-absolute.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "server:quiet": "node server/app.js",
    "start": "node server/app.js",
    "server:watch": "node --watch server/app.js",
    "fetch:ai": "node scripts/fetch-ai-assets.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "fetch:assets": "node scripts/fetch-ai-assets.mjs && node scripts/fetch-fonts.mjs",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "lint-staged": {
    "*.js": [
      "eslint --rulesdir ./eslint-rules --fix",
      "prettier --write"
    ],
    "*.{css,html}": [
      "node scripts/check-no-absolute.js",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "pinyin": "^4.0.0"
  }
}
