  "meta": {
    "title_zh": "虚拟信用分计分、等级与权限降级规则",
    "title_en": "Virtual credit scoring, level and permission-degradation rules",
    "source_document": "易校圈_Project-YXX_商业级项目计划书_V1.0.0.md",
    "source_sections": [
      "5.4.1 分值与等级",
      "5.4.2 计分规则表",
      "5.4.3 虚拟押金冻结",
      "5.4.5 权限降级机制",
      "5.5.2 仲裁流程与 SLA",
      "5.5.3 裁决原则",
      "6.3.1 sys_user",
      "6.3.4 sys_credit_log",
      "6.3.6 cfg_credit_rule",
      "7.2 错误码表"
    ],
    "authority": "本文件是计分规则的唯一事实源（single source of truth）；运行时以 cfg_credit_rule 表为准，由发布流水线做双向同步。",
    "persistence_table": "cfg_credit_rule",
    "persistence_fields": ["rule_key", "delta", "daily_cap", "enabled"],
    "change_control": "任何数值变更须走附录 D 变更控制流程，并同步递增 schema_version。",
    "notes": [
      "delta 的正负即语义：change_type=add 时 delta>0；change_type=deduct 时 delta<0。",
      "daily_cap / monthly_cap 的计量单位为「该规则在自然日/自然月内累计可产生的分数绝对值」，与 5.4.2「单日 +3 / 单月 +15」表述一一对应；null 表示不限。",
      "REGISTER_INIT 不写 sys_credit_log：6.3.4 对账口径为 SUM(delta) == credit_score - 100，故 100 分是核算基线而非流水事件。",
      "DAMAGE_MODERATE(-30) 标注 extension=true：5.4.2 仅列出「轻微/重度」两档，其数值由 5.4.4 定损表的 L2_中度档 deduct=30 派生，用于打通三档定损与计分的映射。",
      "未在文档中定义的两处留白（中值/低值物品划分口径、L5 曝光加权系数）以 null + open_question 标注，不在本期擅自定量。"
    ]
  },
  "score_model": {
    "initial_score": 100,
    "min_score": 0,
    "max_score": null,
    "upper_unbounded": true,
    "score_field": "sys_user.credit_score",
    "frozen_field": "sys_user.credit_frozen",
    "level_field": "sys_user.credit_level",
    "reconciliation": {
      "job": "job-fn",
      "cron": "0 0 2 * * *",
      "timezone": "Asia/Shanghai",
      "assertion": "SUM(sys_credit_log.delta) == sys_user.credit_score - 100",
      "baseline_rules_not_logged": ["REGISTER_INIT"],
      "on_mismatch": "alert",
      "source": "6.3.4"
    }
  },
  "change_types": ["freeze", "unfreeze", "add", "deduct"],
