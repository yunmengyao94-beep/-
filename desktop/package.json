{
  "name": "yxx-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "庆师易校圈桌面客户端",
  "author": "庆师易校圈项目组",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.qsyxx.yxx",
    "productName": "庆师易校圈",
    "copyright": "Copyright © 2026 庆师易校圈项目组",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "!**/*.md",
      "!**/*.map",
      "!**/docs/**",
      "!**/*.log",
      "!**/db.json",
      "!**/db.backup.json",
      "!**/.git/**",
      "!**/screenshots/**",
      "!**/test-results/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YXX-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "庆师易校圈",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": [
          "**/*",
          "!**/*.md",
          "!**/*.map",
          "!**/docs/**",
          "!**/*.log",
          "!**/db.json",
          "!**/db.backup.json",
          "!fonts/NotoSerifSC-Regular.otf"
        ]
      }
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
