  "envelope": {
    "spec": "7.2 统一响应结构",
    "field_order": ["code", "msg", "data", "trace_id", "server_time"],
    "fields": {
      "code": "业务码（整数）。200 成功；其余取值见 7.2 错误码表，如 40001/40101/40301/42901",
      "msg": "提示信息。成功固定为 \"success\"；失败时为可直接展示的中文提示",
      "data": "业务数据。成功时为对象或数组；失败时为错误上下文（如 40301 返回 current_score/required_score）",
      "trace_id": "链路追踪 ID，UUID v4 格式，与日志/告警联动",
      "server_time": "服务端时间，ISO 8601 带时区偏移（7.1 约定示例为 +08:00）"
    },
    "error_example": {
      "code": 40301,
      "msg": "信用分不足，禁止借用高价值物品",
      "data": { "current_score": 52, "required_score": 60 },
      "trace_id": "b7f3c9a1-2d4e-4f6a-8c1d-9e0f2a3b4c5d",
      "server_time": "2026-11-07T10:00:00+08:00"
    }
  },
  "conventions": {
    "naming": "字段一律 snake_case，与 6.3 表结构、7.3 请求示例保持一致",
    "id_type": "BIGINT 统一以 JSON number 返回；对外业务单号用字符串 order_no（如 YXX2026110700017）",
    "time_format": "ISO 8601 带 +08:00 偏移；DB 内按 6.1 存 UTC，接口层转换后返回",
    "pagination": {
      "style": "游标分页（6.4：created_at + id 联合排序，禁止深分页）",
      "query": ["cursor", "limit"],
      "limit_max": 50,
      "sort": "created_at DESC, id DESC",
      "cursor_format": "base64url(JSON) → {\"created_at\":\"...\",\"id\":...}，无填充字符 =，客户端不得解析其内容",
      "shape": "data = { list: [...], pagination: { limit, has_more, next_cursor, sort } }",
      "note": "7.1 仅约定 cursor + limit，未定义外层信封；list/pagination 为本次 mock 约定，接口评审时需固化"
    },
    "masking": {
      "student_no": "按 6.5 脱敏为 2599****20（L4 敏感个人信息）",
      "real_name": "按 6.5 脱敏为 张*（AES-256 密文，接口不返回明文）",
      "device_fp": "绝不下发，仅风控内部使用"
    },
    "credit_formula": {
      "available": "credit_score - credit_frozen - in_flight_frozen（5.4.3）",
      "frozen_scope": "credit_frozen 已含在途订单的冻结分；in_flight_frozen 仅统计尚未落入 frozen 的占用，本 mock 取 0，避免公式重复扣减",
      "reconciliation": "SUM(sys_credit_log.delta) == credit_score - 100（6.3.4）；冻结/解冻 delta 记 0，否则恒等式必破"
    },
    "derived_fields": [
      "credit.available / credit.next_level / credit.gates（由 5.4.1、5.4.5 推导）",
      "credit.frozen_items（由 biz_order + sys_credit_log 聚合）",
      "college_name / major_name（由 5.1.2 学院-专业字典映射）",
      "item.status_label / category_label / owner_credit_level（展示用派生字段）",
      "credit_log.change_type_label（change_type 的中文标签）"
    ],
    "story": "同一用户 100021（张同学，7号楼）的连贯切片：11-02 借雨伞（冻结 10）→ 11-04 逾期 6h20m 归还（-5，余额 95）→ 11-05 借学士服（冻结 20）→ 11-06 20:41 确认无损解冻并按时归还（+1，余额 96）→ 11-07 09:12 借高值假发（冻结 50）。故 score=96（L3）、frozen=50、available=46；全部流水 delta 之和 -4 与 score-100 对账一致。当前页仅展示最近 3 行，-5 分位于下一页"
  },
